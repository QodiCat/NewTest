# OpenAI-compatible chat completions endpoint. Secrets stay on the server.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_ENABLED=false
LLM_TIMEOUT_MS=120000
PORT=3000
HOST=127.0.0.1
